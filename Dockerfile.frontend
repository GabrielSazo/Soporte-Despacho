# Etapa 1: build
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Etapa 2: nginx con TLS
FROM nginx:alpine
RUN apk add --no-cache openssl
# La plantilla usa envsubst con estas variables (solo se sustituyen las definidas;
# las variables de nginx como $host o $scheme quedan intactas).
ENV TLS_CERT=/etc/nginx/certs/cert.pem \
    TLS_KEY=/etc/nginx/certs/key.pem
COPY nginx.conf /etc/nginx/templates/default.conf.template
# Certificado de arranque si no hay propios (corre antes de nginx vía docker-entrypoint.d).
COPY docker/generate-certs.sh /docker-entrypoint.d/45-generate-certs.sh
RUN chmod +x /docker-entrypoint.d/45-generate-certs.sh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
