DJANGO_SECRET_KEY=change-this-value-before-deploying
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
FRONTEND_URL=http://127.0.0.1:5175
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para envío real (ej. Gmail, SES, Mailgun):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_app_password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Sestel Centro de Control <noreply@sestel.local>

# Leave these values unset to use local SQLite during development.
POSTGRES_DB=sestel
POSTGRES_USER=sestel
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Agente IA de prioridad (rama test/ia-vision; en prod mantener desactivado hasta validar).
# El interruptor fino vive en Administración > Agente IA (solo ADMIN) y queda en base de datos.
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5vl:3b
# OLLAMA_REASON_MODEL=qwen3:4b
# OLLAMA_TIMEOUT=180
# IA_VISION_ENABLED=false
# IA_AUTO_APPLY=true
# IA_THRESHOLD=0.8
# IA_SERVICES=FTTH,HFC
# IA_ALLOW_LOWER=true
# IA_COOLDOWN_HOURS=24
